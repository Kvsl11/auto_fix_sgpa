# Senha para entrar no painel web (deixe vazio só em ambiente local)
APP_PASSWORD=troque-esta-senha
# Chave para assinar os tokens de sessão (gere com: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
# Quantos navegadores podem rodar ao mesmo tempo (cada um usa ~300-500 MB de RAM)
MAX_CONCURRENT_JOBS=2
# Origens permitidas quando o front fica em outro domínio (ex.: Vercel), separadas por vírgula
CORS_ORIGINS=*
# Trava remota: o mesmo config.json usado pelo app desktop
REMOTE_CONFIG_URL=https://raw.githubusercontent.com/Kvsl11/auto_fix_sgpa/main/config.json
